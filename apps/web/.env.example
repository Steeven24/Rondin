# Copy to .env.local and fill in. Never commit .env.local.
# Local values are printed by `npx supabase start` (or `npx supabase status`).

# Public: safe to expose to the browser (access is limited by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret: server-only. Used only to create member accounts from an invitation code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app (used in password recovery emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
