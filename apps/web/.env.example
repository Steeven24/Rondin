# Copy to .env.local and fill in. Never commit .env.local.
# Local values are printed by `supabase start` (or `supabase status`).

# Public: safe to expose to the browser (access is limited by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret: server-only. Used to create accounts (members joining with a code, leaders created by the coordinator).
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the app (used in password recovery emails).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
